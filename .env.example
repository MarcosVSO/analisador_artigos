# ---------------------------------------------------------------------------
# Copie para .env e preencha. O .env NAO vai para o git.
# ---------------------------------------------------------------------------

# Chave da Scopus Search API.
# Crie em https://dev.elsevier.com/apikey/manage (login institucional).
SCOPUS_API_KEY=

# Opcional. Token institucional, necessario para usar a API de fora da rede da
# universidade. Pede-se em https://dev.elsevier.com/support.html
SCOPUS_INSTTOKEN=

# E-mail de contato exigido pelo Unpaywall e recomendado pelo OpenAlex
# (entra no "polite pool", com rate limit melhor). Use um e-mail seu real.
CONTACT_EMAIL=

# String de busca padrao. Apenas pre-preenche o campo no frontend; a busca de
# verdade e sempre a que voce digitar na tela.
SCOPUS_QUERY=TITLE-ABS-KEY(("volumetric video" OR "immersive video" OR "360 video") AND stream*) AND PUBYEAR > 2023

# Como o botao "Analisar com IA" funciona:
#   claude_code (padrao) - chama a CLI do Claude Code em modo headless,
#                          usando o SEU login. Sem custo por token alem da
#                          assinatura. Exige a CLI instalada e logada:
#                              npm install -g @anthropic-ai/claude-code
#                              claude   (uma vez, para logar)
#   api                  - usa a Anthropic API, cobrada por token. Exige
#                          ANTHROPIC_API_KEY. Serve para rodar em lote sem
#                          ninguem na frente.
MODO_ANALISE=claude_code

# So no modo "api". Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Ajustes opcionais -----------------------------------------------------
# View da Scopus. COMPLETE traz abstract, mas exige assinatura institucional
# que esta chave nao tem (ver README). Deixe STANDARD.
SCOPUS_VIEW=STANDARD

# A busca traz TODOS os resultados da query. Este teto nao aparece na tela:
# e um freio para uma query ampla demais nao gastar a quota semanal inteira.
# A propria Scopus limita a paginacao por offset a 5.000 nesta chave.
LIMITE_SEGURANCA=5000

# Quantos PDFs baixar em paralelo.
DOWNLOADS_SIMULTANEOS=4

# Modelo usado na analise. claude-opus-5 e o padrao.
MODELO_ANALISE=claude-opus-5
