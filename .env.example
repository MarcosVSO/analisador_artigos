# ---------------------------------------------------------------------------
# Etapa 0 - validacao de viabilidade
# Copie este arquivo para .env e preencha. O .env NAO vai para o git.
# ---------------------------------------------------------------------------

# Chave da Scopus Search API. Crie em https://dev.elsevier.com/apikey/manage
# (login com a conta institucional -> "Create API Key").
SCOPUS_API_KEY=

# Opcional. Token institucional do Elsevier, necessario para usar a API de
# fora da rede da universidade. Pede-se em https://dev.elsevier.com/support.html
# Dentro da rede da universidade, deixe vazio.
SCOPUS_INSTTOKEN=

# E-mail de contato exigido pelo Unpaywall e recomendado pelo OpenAlex
# (entra no "polite pool", com rate limit melhor). Use um e-mail seu real.
CONTACT_EMAIL=

# A string de busca REAL da sua revisao, na sintaxe do Scopus.
# A abaixo e so um ponto de partida do tema de video imersivo - TROQUE pela sua.
SCOPUS_QUERY=TITLE-ABS-KEY(( "volumetric video" OR "immersive video" OR "360 video" OR "6DoF" ) AND ( "stream*" OR "transmission" OR "on demand" ) AND ( "edge computing" OR "network" ) AND ( "QoE" OR "QoS" )) AND PUBYEAR > 2023

# Quantos artigos da amostra testar na resolucao de PDF (cada um faz 1-3
# requisicoes HTTP). 10 a 25 e suficiente para estimar a taxa.
AMOSTRA_PDF=15
